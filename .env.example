# Copy to .env and fill in locally. Never commit .env.
SERVER3_API_KEY=
# deepseek backend (deepseek-v4.1-flash gateway)
DEEPSEEK_API_KEY=

# Optional:
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Shinka code embeddings (Aliyun Bailian, independent of the generation model)
DASHSCOPE_API_KEY=
SHINKA_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SHINKA_EMBEDDING_MODEL=text-embedding-v4
